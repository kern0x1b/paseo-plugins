  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kern0x1b/paseo-plugins.git",
    "directory": "plugins/paseo-slack"
  },
  "homepage": "https://github.com/kern0x1b/paseo-plugins/tree/main/plugins/paseo-slack#readme",
  "bugs": {
    "url": "https://github.com/kern0x1b/paseo-plugins/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "slack": "./bin/slack.js",
    "paseo-slack": "./bin/slack.js"
  },
  "scripts": {
    "start": "node ./bin/slack.js",
    "daemon": "node ./bin/slack.js daemon",
