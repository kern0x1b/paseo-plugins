{
  "name": "paseo-gitlab",
  "version": "1.1.0",
  "description": "A mini GitLab in Paseo: UI explorer plugin, CLI, real-time inbound event router, and MCP server for AI fleets.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kern0x1b/paseo-plugins.git",
    "directory": "plugins/paseo-gitlab"
  },
  "homepage": "https://github.com/kern0x1b/paseo-plugins/tree/main/plugins/paseo-gitlab#readme",
  "bugs": {
    "url": "https://github.com/kern0x1b/paseo-plugins/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "bin/",
    "src/",
    "icon.png"
  ],
  "bin": {
    "gitlab": "./bin/gitlab.js",
    "paseo-gitlab": "./bin/gitlab.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/loader.mjs --test \"test/*.test.ts\" \"test-node/*.test.js\"",
    "start": "node ./bin/gitlab.js",
    "daemon": "node ./bin/gitlab.js daemon",
    "mcp": "node ./bin/gitlab.js mcp"
  },
  "dependencies": {
    "paseo-fleet-kit": "*"
  },
  "main": "src/index.js",
  "keywords": [
    "gitlab",
    "mcp",
    "paseo",
    "ai-agents",
    "fleet-coordination",
    "router",
    "cli"
  ],
  "author": "kern0x1b"
}
